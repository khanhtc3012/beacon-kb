OPENAI_API_KEY=
VECTOR_STORE_NAME=support-kb
HC_BASE_URL=https://support.optisigns.com
HC_LOCALE=en-us
# Optional: cap the number of articles for quick local runs
ARTICLE_LIMIT=
# Optional: chunking (defaults 800 / 200; overlap must not exceed half of max)
CHUNK_MAX_TOKENS=
CHUNK_OVERLAP_TOKENS=
# Optional: after each run, publish a status page to this S3 bucket (set by deploy/aws.sh on AWS)
LOG_BUCKET=
